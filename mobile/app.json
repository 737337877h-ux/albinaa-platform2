{
  "expo": {
    "owner": "alqalisi",
    "name": "ALRAQi ERP",
    "slug": "albinaa-collector",
    "version": "1.3.15",
    "orientation": "portrait",
    "icon": "./assets/alraqi-app-icon-approved.png",
    "userInterfaceStyle": "light",
    "scheme": "albinaa",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.albinaa.collector",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "يستخدم تطبيق المحصل موقعك لتسجيل نقاط التحصيل",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "يستخدم تطبيق المحصل موقعك في الخلفية لتتبع مسار التحصيل",
        "NSCameraUsageDescription": "يستخدم التطبيق الكاميرا لتصوير سندات التحصيل",
        "NSPhotoLibraryUsageDescription": "يستخدم التطبيق معرض الصور لرفع سندات التحصيل"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#275E59",
        "foregroundImage": "./assets/alraqi-adaptive-foreground-approved.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 19,
      "package": "com.albinaa.collector",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/with-cleartext-traffic.js",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F9FA",
          "image": "./assets/alraqi-header-flat-approved.png",
          "imageWidth": 230,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Tajawal-Regular.ttf",
            "./assets/fonts/Tajawal-Medium.ttf",
            "./assets/fonts/Tajawal-Bold.ttf",
            "./assets/fonts/Tajawal-ExtraBold.ttf",
            "./assets/fonts/Tajawal-Black.ttf"
          ],
          "android": {
            "fonts": [
              {
                "fontFamily": "Tajawal",
                "fontDefinitions": [
                  { "path": "./assets/fonts/Tajawal-Regular.ttf", "weight": 400 },
                  { "path": "./assets/fonts/Tajawal-Medium.ttf", "weight": 500 },
                  { "path": "./assets/fonts/Tajawal-Bold.ttf", "weight": 700 },
                  { "path": "./assets/fonts/Tajawal-ExtraBold.ttf", "weight": 800 },
                  { "path": "./assets/fonts/Tajawal-Black.ttf", "weight": 900 }
                ]
              }
            ]
          }
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-contacts",
        {
          "contactsPermission": "يستخدم تطبيق الراقي جهات الاتصال لاختيار رقم العميل أو حفظه في الهاتف"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "يستخدم تطبيق الراقي بصمة الوجه لفتح البيانات المحفوظة بأمان"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#D4AF37",
          "defaultChannel": "albinaa-reminders",
          "sounds": ["./assets/sounds/news_flash.mp3"]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "يستخدم تطبيق المحصل موقعك لتسجيل نقاط التحصيل",
          "locationAlwaysAndWhenInUsePermission": "يستخدم تطبيق المحصل موقعك في الخلفية لتتبع مسار التحصيل"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "يستخدم التطبيق معرض الصور لرفع سندات التحصيل",
          "cameraPermission": "يستخدم التطبيق الكاميرا لتصوير سندات التحصيل"
        }
      ]
    ],
    "extra": {
      "apiUrl": {
        "development": "http://localhost:3000",
        "preview": "https://api.albinaa.com",
        "production": "https://api.albinaa.com"
      },
      "eas": {
        "projectId": "1c9056d8-ce20-4d8f-8ee9-d6716ebf459b"
      }
    }
  }
}
