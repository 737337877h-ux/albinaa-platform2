{
  "expo": {
    "owner": "alqalisi",
    "name": "الراقي",
    "slug": "albinaa-collector",
    "version": "1.3.1",
    "orientation": "portrait",
    "icon": "./assets/alraqi-brand.png",
    "userInterfaceStyle": "light",
    "scheme": "albinaa",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.albinaa.collector",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "يستخدم تطبيق المحصل موقعك لتسجيل نقاط التحصيل",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "يستخدم تطبيق المحصل موقعك في الخلفية لتتبع مسار التحصيل",
        "NSCameraUsageDescription": "يستخدم التطبيق الكاميرا لتصوير سندات التحصيل",
        "NSPhotoLibraryUsageDescription": "يستخدم التطبيق معرض الصور لرفع سندات التحصيل"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F6F1",
        "foregroundImage": "./assets/alraqi-brand.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 5,
      "package": "com.albinaa.collector",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/with-cleartext-traffic.js",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F6F1",
          "image": "./assets/alraqi-brand.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-contacts",
        {
          "contactsPermission": "يستخدم تطبيق الراقي جهات الاتصال لاختيار رقم العميل أو حفظه في الهاتف"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "يستخدم تطبيق الراقي بصمة الوجه لفتح البيانات المحفوظة بأمان"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#0A4A3C",
          "defaultChannel": "albinaa-reminders"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "يستخدم تطبيق المحصل موقعك لتسجيل نقاط التحصيل",
          "locationAlwaysAndWhenInUsePermission": "يستخدم تطبيق المحصل موقعك في الخلفية لتتبع مسار التحصيل"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "يستخدم التطبيق معرض الصور لرفع سندات التحصيل",
          "cameraPermission": "يستخدم التطبيق الكاميرا لتصوير سندات التحصيل"
        }
      ]
    ],
    "extra": {
      "apiUrl": {
        "development": "http://localhost:3000",
        "preview": "https://api.albinaa.com",
        "production": "https://api.albinaa.com"
      },
      "eas": {
        "projectId": "1c9056d8-ce20-4d8f-8ee9-d6716ebf459b"
      }
    }
  }
}
