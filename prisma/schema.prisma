  remainingQty Decimal? @map("remaining_qty") @db.Decimal(18, 4)
  createdBy    String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  documentNumber String?   @map("document_number")
  warehouse      String?
  reservedAt     DateTime  @default(dbgenerated("CURRENT_DATE")) @map("reserved_at") @db.Date
  expiresAt      DateTime? @map("expires_at") @db.Date
  status         String    @default("open")
  notes          String?

  customer    Customer          @relation(fields: [customerId], references: [id])
  currency    Currency          @relation(fields: [currencyCode], references: [code])
  creator     User?             @relation("ReservationCreator", fields: [createdBy], references: [id])
  measureUnit Unit?             @relation(fields: [unitId], references: [id])
  items       ReservationItem[]

  @@index([customerId], map: "idx_reservations_customer")
