// ============================================================================
// منصة البناء الراقي — Prisma Schema (Sprint 1)
// يطابق Migration: 20260717000000_init حرفيًا (36 جدولاً)
//
// ملاحظات مهمة:
// - القيود من نوع CHECK، والفهرس الجزئي uq_current_assignment،
//   وTriggers الحماية (forbid_mutation)، وMaterialized View (operational_balances)
//   كلها معرّفة في ملف الـ migration SQL لأن Prisma لا يمثّلها في الـ schema —
//   وهي سارية المفعول في قاعدة البيانات بشكل كامل.
// - لتطوير المخطط مستقبلاً: عدّل هذا الملف ثم
//   `npx prisma migrate dev --create-only` وأضف أي SQL مخصص للملف الناتج.
// - التطبيق: `npx prisma migrate deploy` (وليس dev) في بيئات التشغيل.
// ============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../backend/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// 1) الهيكل التنظيمي
// ---------------------------------------------------------------------------
model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  branches                    Branch[]
  hrEmployees                 HrEmployee[]
  users                       User[]
  roles                       Role[]
  documentTypes               DocumentType[]
  customers                   Customer[]
  importTemplates             ImportTemplate[]
  importJobs                  ImportJob[]
  collectionMethods           CollectionMethod[]
  followupTypes               FollowupType[]
  followupResults             FollowupResult[]
  systemSettings              SystemSetting[]
  analyticalAccounts          AnalyticalAccount[]
  customerAliases             CustomerAlias[]
  customerMerges              CustomerMerge[]
  customerAccountLinks        CustomerAccountLink[]
  agingSnapshots              AgingSnapshot[]
  handoverVouchers            CollectionHandoverVoucher[]
  messageCampaigns            MessageCampaign[]
  assignmentChangeRequests    AssignmentChangeRequest[]
  financialAdjustmentRequests FinancialAdjustmentRequest[]
  oracleInventorySyncRuns     OracleInventorySyncRun[]
  oracleActiveSnapshots       OracleInventoryActiveSnapshot[]
  oracleItemGroups            OracleItemGroupMirror[]
  oracleItems                 OracleItemMirror[]
  oracleItemUnits             OracleItemUnitMirror[]
  oracleWarehouseGroups       OracleWarehouseGroupMirror[]
  oracleWarehouses            OracleWarehouseMirror[]
  oracleStockBalances         OracleStockBalanceMirror[]
  oracleBranchMappings        OracleBranchMapping[]
  oracleSyncIssues            OracleSyncIssue[]
  oracleCustomerSyncRuns      OracleCustomerSyncRun[]
  oracleCustomers             OracleCustomerMirror[]
  oracleCustomerCurrencies    OracleCustomerCurrencyMirror[]
  oracleCustomerBalances      OracleCustomerBalanceMirror[]
  inventoryTransferRequests   InventoryTransferRequest[]

  @@map("organizations")
}

model HrEmployee {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id])
  employeeNo String @map("employee_no")
  fullName String @map("full_name")
  jobTitle String @map("job_title")
  managerNo String? @map("manager_no")
  active Boolean @default(true)
  workMode String @map("work_mode")
  attendanceExempt Boolean @default(false) @map("attendance_exempt")
  startTime String? @map("start_time")
  endTime String? @map("end_time")
  breakMinutes Int @default(90) @map("break_minutes")
  breakStartTime String? @default("13:00") @map("break_start_time")
  breakEndTime String? @default("14:30") @map("break_end_time")
  workDays Int[] @map("work_days")
  notes String @default("")
  profile Json @default("{}")
  payrollStart DateTime @map("payroll_start") @db.Date
  legacyInstallmentsPending Boolean @default(true) @map("legacy_installments_pending")
  accountLinks Json @default("[]") @map("account_links")
  version Int @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  salaries HrSalary[]
  payrollDrafts HrPayrollDraft[]
  loginUserId String? @unique @map("login_user_id") @db.Uuid
  loginUser User? @relation(fields:[loginUserId],references:[id])
  requests HrRequest[]
  attendance HrAttendance[]
  taskAssignments HrTaskAssignment[]
  @@unique([organizationId, employeeNo])
  @@map("hr_employees")
}

model HrSalary {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId String @map("employee_id") @db.Uuid
  employee HrEmployee @relation(fields: [employeeId], references: [id])
  effectiveFrom DateTime @map("effective_from") @db.Date
  baseSalary Decimal @map("base_salary") @db.Decimal(18,2)
  fixedAllowance Decimal? @map("fixed_allowance") @db.Decimal(18,2)
  currency String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  @@unique([employeeId, effectiveFrom])
  @@map("hr_salaries")
}

model HrTask {
 id String @id @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 createdBy String @map("created_by") @db.Uuid
 title String
 description String
 dueDate DateTime @map("due_date") @db.Date
 creationHash String @map("creation_hash")
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
 assignments HrTaskAssignment[]
 @@index([organizationId,dueDate])
 @@map("hr_tasks")
}
model HrTaskAssignment {
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 taskId String @map("task_id") @db.Uuid
 task HrTask @relation(fields:[taskId],references:[id])
 employeeId String @map("employee_id") @db.Uuid
 employee HrEmployee @relation(fields:[employeeId],references:[id])
 status String @default("assigned")
 completionNote String? @map("completion_note")
 submittedAt DateTime? @map("submitted_at") @db.Timestamptz()
 reviewNote String? @map("review_note")
 rating Int?
 reviewedBy String? @map("reviewed_by") @db.Uuid
 reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz()
 version Int @default(1)
 lastOperationId String? @unique @map("last_operation_id") @db.Uuid
 lastOperationHash String? @map("last_operation_hash")
 @@unique([taskId,employeeId])
 @@index([employeeId,status])
 @@map("hr_task_assignments")
}

model HrAttendance {
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 employeeId String @map("employee_id") @db.Uuid
 employee HrEmployee @relation(fields:[employeeId],references:[id])
 workDate DateTime @map("work_date") @db.Date
 checkIn DateTime @map("check_in") @db.Timestamptz()
 checkOut DateTime? @map("check_out") @db.Timestamptz()
 breakOut DateTime? @map("break_out") @db.Timestamptz()
 breakIn DateTime? @map("break_in") @db.Timestamptz()
 breakOutOperationId String? @unique @map("break_out_operation_id") @db.Uuid
 breakInOperationId String? @unique @map("break_in_operation_id") @db.Uuid
 breakOutEvidence Json? @map("break_out_evidence")
 breakInEvidence Json? @map("break_in_evidence")
 inOperationId String @unique @map("in_operation_id") @db.Uuid
 outOperationId String? @unique @map("out_operation_id") @db.Uuid
 inEvidence Json @map("in_evidence")
 outEvidence Json? @map("out_evidence")
 schedule Json
 @@unique([employeeId,workDate])
 @@map("hr_attendance")
}

model HrAttendancePolicy {
 organizationId String @id @map("organization_id") @db.Uuid
 startDate DateTime @map("start_date") @db.Date
 payrollRules Json @default("[]") @map("payroll_rules")
 version Int @default(1)
 @@map("hr_attendance_policies")
}
model HrAttendanceDisplay {
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 tokenHash String @unique @map("token_hash")
 createdBy String @map("created_by") @db.Uuid
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
 revokedAt DateTime? @map("revoked_at") @db.Timestamptz()
 @@map("hr_attendance_displays")
}
model HrPushDelivery {
 id String @id @db.Uuid
 userId String @map("user_id") @db.Uuid
 kind String
 payload Json
 status String @default("queued")
 attempts Int @default(0)
 nextAttempt DateTime @default(now()) @map("next_attempt") @db.Timestamptz()
 result Json?
 @@index([status,nextAttempt])
 @@map("hr_push_deliveries")
}

model HrRequest {
 id String @id @db.Uuid
 employeeId String @map("employee_id") @db.Uuid
 employee HrEmployee @relation(fields:[employeeId],references:[id])
 submittedBy String @map("submitted_by") @db.Uuid
 kind String
 amount Decimal? @db.Decimal(18,2)
 currency String?
 startDate DateTime? @map("start_date") @db.Date
 endDate DateTime? @map("end_date") @db.Date
 leaveType String? @map("leave_type")
 reason String
 monthlyInstallment Decimal? @map("monthly_installment") @db.Decimal(18,2)
 installmentStartMonth String? @map("installment_start_month")
 status String @default("pending")
 decisionReason String? @map("decision_reason")
 reviewedBy String? @map("reviewed_by") @db.Uuid
 reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz()
 version Int @default(1)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
 @@index([employeeId,createdAt])
 @@map("hr_requests")
}

model HrEmployeeDocument {
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 employeeId String @map("employee_id") @db.Uuid
 name String
 mime String
 content Bytes
 expiresOn DateTime? @map("expires_on") @db.Date
 createdBy String @map("created_by") @db.Uuid
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
 @@index([employeeId])
 @@map("hr_employee_documents")
}

model HrAbsenceReview {
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 employeeId String @map("employee_id") @db.Uuid
 workDate DateTime @map("work_date") @db.Date
 status String
 reason String
 reviewedBy String @map("reviewed_by") @db.Uuid
 reviewedAt DateTime @default(now()) @map("reviewed_at") @db.Timestamptz()
 version Int @default(1)
 @@unique([employeeId,workDate])
 @@map("hr_absence_reviews")
}

model HrPayrollApproval {
 id String @id @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 month String
 revision Int
 status String @default("approved")
 snapshot Json
 reviewHash String @map("review_hash")
 reason String
 approvedBy String @map("approved_by") @db.Uuid
 approvedAt DateTime @default(now()) @map("approved_at") @db.Timestamptz()
 reopenedBy String? @map("reopened_by") @db.Uuid
 reopenedAt DateTime? @map("reopened_at") @db.Timestamptz()
 reopenReason String? @map("reopen_reason")
 reopenOperationId String? @unique @map("reopen_operation_id") @db.Uuid
 version Int @default(1)
 @@unique([organizationId,month,revision])
 @@index([organizationId,month,status])
 @@map("hr_payroll_approvals")
}

model HrPayrollDraft {
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 employeeId String @map("employee_id") @db.Uuid
 employee HrEmployee @relation(fields:[employeeId],references:[id])
 month String
 inputs Json
 calculation Json
 snapshotHash String @map("snapshot_hash")
 version Int @default(1)
 updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()
 @@unique([employeeId,month])
 @@map("hr_payroll_drafts")
}

model Branch {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  organization     Organization                @relation(fields: [organizationId], references: [id])
  users            User[]
  collectors       Collector[]
  customers        Customer[]
  collections      Collection[]
  handoverVouchers CollectionHandoverVoucher[]
  receiptSequence  BranchReceiptSequence[]
  voucherSequence  BranchVoucherSequence[]
  oracleMappings   OracleBranchMapping[]

  @@unique([organizationId, name], map: "uq_branches_org_name")
  @@map("branches")
}

// ---------------------------------------------------------------------------
// 2) المستخدمون والأدوار والصلاحيات (RBAC)
// ---------------------------------------------------------------------------
model User {
  hrEmployee HrEmployee?
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  branchId       String?   @map("branch_id") @db.Uuid
  username       String
  fullName       String    @map("full_name")
  phone          String?
  passwordHash   String    @map("password_hash")
  isActive       Boolean   @default(true) @map("is_active")
  lastLoginAt    DateTime? @map("last_login_at") @db.Timestamptz()
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch?      @relation(fields: [branchId], references: [id])

  collector                           Collector?
  userRoles                           UserRole[]                   @relation("UserOwnRoles")
  rolesGranted                        UserRole[]                   @relation("RoleGranter")
  assignmentsMade                     CustomerAssignment[]         @relation("AssignmentMaker")
  creditDecisions                     CustomerCreditPolicy[]       @relation("CreditDecider")
  creditLimitApprovals                CustomerCreditLimit[]        @relation("CreditLimitApprover")
  collectorTargetsSet                 CollectorTarget[]            @relation("CollectorTargetSetter")
  duplicateReviews                    PotentialDuplicateCustomer[] @relation("DuplicateReviewer")
  customerMergesCreated               CustomerMerge[]              @relation("CustomerMergeCreator")
  customerMergesReversed              CustomerMerge[]              @relation("CustomerMergeReverser")
  importTemplates                     ImportTemplate[]
  importJobs                          ImportJob[]
  importJobsReversed                  ImportJob[]                  @relation("ImportJobReverser")
  ledgerEntries                       OperationalLedger[]
  reconciliationsDone                 BalanceReconciliation[]      @relation("ReconReviewer")
  cashReceived                        CashHandover[]
  handoverVouchersCreated             CollectionHandoverVoucher[]  @relation("HandoverVoucherCreator")
  handoverVouchersMatched             CollectionHandoverVoucher[]  @relation("HandoverVoucherMatcher")
  handoverVouchersApproved            CollectionHandoverVoucher[]  @relation("HandoverVoucherApprover")
  reversalRequestsMade                CollectionReversalRequest[]  @relation("CollectionReversalRequester")
  reversalRequestsReviewed            CollectionReversalRequest[]  @relation("CollectionReversalReviewer")
  followups                           Followup[]
  tasksCreated                        Task[]                       @relation("TaskCreator")
  reservationsCreated                 Reservation[]                @relation("ReservationCreator")
  analyticalAccountsCreated           AnalyticalAccount[]          @relation("AnalyticalAccountCreator")
  messageCampaignsCreated             MessageCampaign[]            @relation("MessageCampaignCreator")
  attachments                         Attachment[]
  gpsLogs                             GpsLog[]
  notifications                       Notification[]
  pushTokens                          DevicePushToken[]
  deviceSessions                      MobileDeviceSession[]
  auditLogs                           AuditLog[]
  authSessions                        AuthSession[]
  assignmentChangeRequestsMade        AssignmentChangeRequest[]    @relation("AssignmentChangeRequester")
  assignmentChangeRequestsReviewed    AssignmentChangeRequest[]    @relation("AssignmentChangeReviewer")
  financialAdjustmentRequestsMade     FinancialAdjustmentRequest[] @relation("FinancialAdjustmentRequester")
  financialAdjustmentRequestsReviewed FinancialAdjustmentRequest[] @relation("FinancialAdjustmentReviewer")
  oracleSyncRunsTriggered             OracleInventorySyncRun[]     @relation("OracleSyncTriggeredBy")
  oracleCustomerSyncRunsTriggered     OracleCustomerSyncRun[]      @relation("OracleCustomerSyncTriggeredBy")
  inventoryTransfersCreated           InventoryTransferRequest[]   @relation("InventoryTransferCreator")
  inventoryTransfersSubmitted         InventoryTransferRequest[]   @relation("InventoryTransferSubmitter")
  inventoryTransfersReviewed          InventoryTransferRequest[]   @relation("InventoryTransferReviewer")
  oracleBranchMappingsVerified        OracleBranchMapping[]        @relation("OracleBranchMappingVerifiedBy")

  @@unique([organizationId, username], map: "uq_users_org_username")
  @@map("users")
}

model Role {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  name           String
  isSystem       Boolean @default(false) @map("is_system")

  organization    Organization     @relation(fields: [organizationId], references: [id])
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([organizationId, name], map: "uq_roles_org_name")
  @@map("roles")
}

model Permission {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String @unique
  descriptionAr String @map("description_ar")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  grantedBy String?  @map("granted_by") @db.Uuid
  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz()

  user    User  @relation("UserOwnRoles", fields: [userId], references: [id], onDelete: Cascade)
  role    Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  granter User? @relation("RoleGranter", fields: [grantedBy], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model Collector {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String  @unique @map("user_id") @db.Uuid
  branchId          String? @map("branch_id") @db.Uuid
  oracleCollectorNo Int?    @unique(map: "uq_collectors_oracle_collector_no") @map("oracle_collector_no") @db.SmallInt
  active            Boolean @default(true)

  user   User    @relation(fields: [userId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])

  assignments                         CustomerAssignment[]
  collections                         Collection[]
  paymentPromises                     PaymentPromise[]
  tasks                               Task[]
  targets                             CollectorTarget[]
  handoverVouchers                    CollectionHandoverVoucher[]
  assignmentChangeRequestsCurrent     AssignmentChangeRequest[]   @relation("AssignmentChangeCurrentCollector")
  assignmentChangeRequestsReplacement AssignmentChangeRequest[]   @relation("AssignmentChangeReplacementCollector")

  @@map("collectors")
}

// ---------------------------------------------------------------------------
// 3) البيانات المرجعية: العملات وأنواع المستندات
// ---------------------------------------------------------------------------
model Currency {
  code         String  @id
  sourceCode   String  @map("source_code")
  nameAr       String  @map("name_ar")
  decimals     Int     @default(2) @db.SmallInt
  active       Boolean @default(true)
  exchangeRate Decimal @default(1) @map("exchange_rate") @db.Decimal(18, 6)

  balances                   CustomerBalance[]
  importedTxns               ImportedTransaction[]
  ledgerEntries              OperationalLedger[]
  reconciliations            BalanceReconciliation[]
  collections                Collection[]
  cashHandovers              CashHandover[]
  promises                   PaymentPromise[]
  reservations               Reservation[]
  tasksExpected              Task[]
  followupsExpected          Followup[]
  creditPolicies             CustomerCreditPolicy[]
  customerCreditLimits       CustomerCreditLimit[]
  collectorTargets           CollectorTarget[]
  balanceSnapshots           BalanceSnapshot[]
  agingRows                  DebtAgingSummary[]
  agingDocuments             DebtAgingDetail[]
  analyticalAccounts         AnalyticalAccount[]
  analyticalMovements        AnalyticalMovement[]
  agingSnapshots             AgingSnapshot[]
  collectionHandoverVouchers CollectionHandoverVoucher[]

  @@map("currencies")
}

model CollectorTarget {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collectorId  String   @map("collector_id") @db.Uuid
  currencyCode String   @map("currency_code")
  month        DateTime @db.Date
  targetAmount Decimal  @map("target_amount") @db.Decimal(18, 4)
  setBy        String   @map("set_by") @db.Uuid
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  collector Collector @relation(fields: [collectorId], references: [id])
  currency  Currency  @relation(fields: [currencyCode], references: [code])
  setter    User      @relation("CollectorTargetSetter", fields: [setBy], references: [id])

  @@unique([collectorId, currencyCode, month], map: "uq_collector_target_month_currency")
  @@index([month, currencyCode], map: "idx_collector_targets_month_currency")
  @@map("collector_targets")
}

model DocumentType {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  name           String
  effect         String // debit | credit | mixed — CHECK في SQL
  active         Boolean @default(true)
  notes          String?

  organization Organization          @relation(fields: [organizationId], references: [id])
  transactions ImportedTransaction[]

  @@unique([organizationId, name], map: "uq_doctypes_org_name")
  @@map("document_types")
}

// ---------------------------------------------------------------------------
// 4) العملاء
// ---------------------------------------------------------------------------
model Customer {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String    @map("organization_id") @db.Uuid
  branchId              String?   @map("branch_id") @db.Uuid
  externalCustomerCode  String    @map("external_customer_code")
  accountNumber         String?   @map("account_number")
  name                  String
  nameNormalized        String    @map("name_normalized")
  tradeName             String?   @map("trade_name")
  phonePrimary          String?   @map("phone_primary")
  phoneSecondary        String?   @map("phone_secondary")
  whatsapp              String?
  region                String?
  address               String?
  geoLat                Decimal?  @map("geo_lat") @db.Decimal(9, 6)
  geoLng                Decimal?  @map("geo_lng") @db.Decimal(9, 6)
  customerType          String?   @map("customer_type")
  status                String    @default("active")
  relationshipStartDate DateTime? @map("relationship_start_date") @db.Date
  notes                 String?
  createdByImportJob    String?   @map("created_by_import_job") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz()
  mergedIntoId          String?   @map("merged_into_id") @db.Uuid
  mergedAt              DateTime? @map("merged_at") @db.Timestamptz()

  organization  Organization @relation(fields: [organizationId], references: [id])
  branch        Branch?      @relation(fields: [branchId], references: [id])
  mergedInto    Customer?    @relation("CustomerMergeTarget", fields: [mergedIntoId], references: [id])
  mergedSources Customer[]   @relation("CustomerMergeTarget")

  balances                    CustomerBalance[]
  creditPolicy                CustomerCreditPolicy?
  creditLimits                CustomerCreditLimit[]
  assignments                 CustomerAssignment[]
  importedTxns                ImportedTransaction[]
  balanceSnapshots            BalanceSnapshot[]
  ledgerEntries               OperationalLedger[]
  reconciliations             BalanceReconciliation[]
  followups                   Followup[]
  promises                    PaymentPromise[]
  collections                 Collection[]
  reservations                Reservation[]
  tasks                       Task[]
  scores                      CustomerScore[]
  duplicatesAsA               PotentialDuplicateCustomer[] @relation("DupCustomerA")
  duplicatesAsB               PotentialDuplicateCustomer[] @relation("DupCustomerB")
  agingRows                   DebtAgingSummary[]
  agingDocuments              DebtAgingDetail[]
  aliases                     CustomerAlias[]              @relation("CustomerAliasTarget")
  aliasesFromMerge            CustomerAlias[]              @relation("CustomerAliasSource")
  mergeOperationsAsMaster     CustomerMerge[]              @relation("CustomerMergeMaster")
  mergeOperationsAsSource     CustomerMerge[]              @relation("CustomerMergeSource")
  primaryAccountLinks         CustomerAccountLink[]        @relation("PrimaryCustomerAccount")
  childAccountLink            CustomerAccountLink?         @relation("ChildCustomerAccount")
  agingSnapshots              AgingSnapshot[]
  messageDispatches           MessageDispatch[]
  assignmentChangeRequests    AssignmentChangeRequest[]
  financialAdjustmentRequests FinancialAdjustmentRequest[]

  @@unique([organizationId, externalCustomerCode], map: "uq_customers_org_code")
  @@index([organizationId, nameNormalized], map: "idx_customers_name_norm")
  @@index([phonePrimary], map: "idx_customers_phone")
  @@index([mergedIntoId], map: "idx_customers_merged_into")
  @@map("customers")
}

model CustomerAlias {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  customerId       String   @map("customer_id") @db.Uuid
  sourceCustomerId String?  @map("source_customer_id") @db.Uuid
  mergeId          String?  @map("merge_id") @db.Uuid
  aliasType        String   @map("alias_type")
  aliasValue       String   @map("alias_value")
  aliasNormalized  String   @map("alias_normalized")
