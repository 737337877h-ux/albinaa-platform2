// ============================================================================
// منصة البناء الراقي — Prisma Schema (Sprint 1)
// يطابق Migration: 20260717000000_init حرفيًا (36 جدولاً)
//
// ملاحظات مهمة:
// - القيود من نوع CHECK، والفهرس الجزئي uq_current_assignment،
//   وTriggers الحماية (forbid_mutation)، وMaterialized View (operational_balances)
//   كلها معرّفة في ملف الـ migration SQL لأن Prisma لا يمثّلها في الـ schema —
//   وهي سارية المفعول في قاعدة البيانات بشكل كامل.
// - لتطوير المخطط مستقبلاً: عدّل هذا الملف ثم
//   `npx prisma migrate dev --create-only` وأضف أي SQL مخصص للملف الناتج.
// - التطبيق: `npx prisma migrate deploy` (وليس dev) في بيئات التشغيل.
// ============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../backend/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// 1) الهيكل التنظيمي
// ---------------------------------------------------------------------------
model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  branches             Branch[]
  users                User[]
  roles                Role[]
  documentTypes        DocumentType[]
  customers            Customer[]
  importTemplates      ImportTemplate[]
  importJobs           ImportJob[]
  collectionMethods    CollectionMethod[]
  followupTypes        FollowupType[]
  followupResults      FollowupResult[]
  systemSettings       SystemSetting[]
  analyticalAccounts   AnalyticalAccount[]
  customerAliases      CustomerAlias[]
  customerMerges       CustomerMerge[]
  customerAccountLinks CustomerAccountLink[]
  agingSnapshots       AgingSnapshot[]
  handoverVouchers     CollectionHandoverVoucher[]

  @@map("organizations")
}

model Branch {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  organization     Organization                @relation(fields: [organizationId], references: [id])
  users            User[]
  collectors       Collector[]
  customers        Customer[]
  collections      Collection[]
  handoverVouchers CollectionHandoverVoucher[]
  receiptSequence  BranchReceiptSequence[]
  voucherSequence  BranchVoucherSequence[]

  @@unique([organizationId, name], map: "uq_branches_org_name")
  @@map("branches")
}

// ---------------------------------------------------------------------------
// 2) المستخدمون والأدوار والصلاحيات (RBAC)
// ---------------------------------------------------------------------------
model User {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  branchId       String?   @map("branch_id") @db.Uuid
  username       String
  fullName       String    @map("full_name")
  phone          String?
  passwordHash   String    @map("password_hash")
  isActive       Boolean   @default(true) @map("is_active")
  lastLoginAt    DateTime? @map("last_login_at") @db.Timestamptz()
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch?      @relation(fields: [branchId], references: [id])

  collector                 Collector?
  userRoles                 UserRole[]                   @relation("UserOwnRoles")
  rolesGranted              UserRole[]                   @relation("RoleGranter")
  assignmentsMade           CustomerAssignment[]         @relation("AssignmentMaker")
  creditDecisions           CustomerCreditPolicy[]       @relation("CreditDecider")
  creditLimitApprovals      CustomerCreditLimit[]        @relation("CreditLimitApprover")
  collectorTargetsSet       CollectorTarget[]            @relation("CollectorTargetSetter")
  duplicateReviews          PotentialDuplicateCustomer[] @relation("DuplicateReviewer")
  customerMergesCreated     CustomerMerge[]              @relation("CustomerMergeCreator")
  customerMergesReversed    CustomerMerge[]              @relation("CustomerMergeReverser")
  importTemplates           ImportTemplate[]
  importJobs                ImportJob[]
  importJobsReversed        ImportJob[]                  @relation("ImportJobReverser")
  ledgerEntries             OperationalLedger[]
  reconciliationsDone       BalanceReconciliation[]      @relation("ReconReviewer")
  cashReceived              CashHandover[]
  handoverVouchersCreated   CollectionHandoverVoucher[]  @relation("HandoverVoucherCreator")
  handoverVouchersMatched   CollectionHandoverVoucher[]  @relation("HandoverVoucherMatcher")
  handoverVouchersApproved  CollectionHandoverVoucher[]  @relation("HandoverVoucherApprover")
  reversalRequestsMade      CollectionReversalRequest[]  @relation("CollectionReversalRequester")
  reversalRequestsReviewed  CollectionReversalRequest[]  @relation("CollectionReversalReviewer")
  followups                 Followup[]
  tasksCreated              Task[]                       @relation("TaskCreator")
  reservationsCreated       Reservation[]                @relation("ReservationCreator")
  analyticalAccountsCreated AnalyticalAccount[]          @relation("AnalyticalAccountCreator")
  attachments               Attachment[]
  gpsLogs                   GpsLog[]
  notifications             Notification[]
  auditLogs                 AuditLog[]
  authSessions              AuthSession[]

  @@unique([organizationId, username], map: "uq_users_org_username")
  @@map("users")
}

model Role {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  name           String
  isSystem       Boolean @default(false) @map("is_system")

  organization    Organization     @relation(fields: [organizationId], references: [id])
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([organizationId, name], map: "uq_roles_org_name")
  @@map("roles")
}

model Permission {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String @unique
  descriptionAr String @map("description_ar")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  grantedBy String?  @map("granted_by") @db.Uuid
  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz()

  user    User  @relation("UserOwnRoles", fields: [userId], references: [id], onDelete: Cascade)
  role    Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  granter User? @relation("RoleGranter", fields: [grantedBy], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model Collector {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId   String  @unique @map("user_id") @db.Uuid
  branchId String? @map("branch_id") @db.Uuid
  active   Boolean @default(true)

  user   User    @relation(fields: [userId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])

  assignments      CustomerAssignment[]
  collections      Collection[]
  paymentPromises  PaymentPromise[]
  tasks            Task[]
  targets          CollectorTarget[]
  handoverVouchers CollectionHandoverVoucher[]

  @@map("collectors")
}

// ---------------------------------------------------------------------------
// 3) البيانات المرجعية: العملات وأنواع المستندات
// ---------------------------------------------------------------------------
model Currency {
  code       String  @id
  sourceCode String  @map("source_code")
  nameAr     String  @map("name_ar")
  decimals   Int     @default(2) @db.SmallInt
  active     Boolean @default(true)

  balances                   CustomerBalance[]
  importedTxns               ImportedTransaction[]
  ledgerEntries              OperationalLedger[]
  reconciliations            BalanceReconciliation[]
  collections                Collection[]
  cashHandovers              CashHandover[]
  promises                   PaymentPromise[]
  reservations               Reservation[]
  tasksExpected              Task[]
  followupsExpected          Followup[]
  creditPolicies             CustomerCreditPolicy[]
  customerCreditLimits       CustomerCreditLimit[]
  collectorTargets           CollectorTarget[]
  balanceSnapshots           BalanceSnapshot[]
  agingRows                  DebtAgingSummary[]
  agingDocuments             DebtAgingDetail[]
  analyticalAccounts         AnalyticalAccount[]
  analyticalMovements        AnalyticalMovement[]
  agingSnapshots             AgingSnapshot[]
  collectionHandoverVouchers CollectionHandoverVoucher[]

  @@map("currencies")
}

model CollectorTarget {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collectorId  String   @map("collector_id") @db.Uuid
  currencyCode String   @map("currency_code")
  month        DateTime @db.Date
  targetAmount Decimal  @map("target_amount") @db.Decimal(18, 4)
  setBy        String   @map("set_by") @db.Uuid
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  collector Collector @relation(fields: [collectorId], references: [id])
  currency  Currency  @relation(fields: [currencyCode], references: [code])
  setter    User      @relation("CollectorTargetSetter", fields: [setBy], references: [id])

  @@unique([collectorId, currencyCode, month], map: "uq_collector_target_month_currency")
  @@index([month, currencyCode], map: "idx_collector_targets_month_currency")
  @@map("collector_targets")
}

model DocumentType {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  name           String
  effect         String // debit | credit | mixed — CHECK في SQL
  active         Boolean @default(true)
  notes          String?

  organization Organization          @relation(fields: [organizationId], references: [id])
  transactions ImportedTransaction[]

  @@unique([organizationId, name], map: "uq_doctypes_org_name")
  @@map("document_types")
}

// ---------------------------------------------------------------------------
// 4) العملاء
// ---------------------------------------------------------------------------
model Customer {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String    @map("organization_id") @db.Uuid
  branchId              String?   @map("branch_id") @db.Uuid
  externalCustomerCode  String    @map("external_customer_code")
  accountNumber         String?   @map("account_number")
  name                  String
  nameNormalized        String    @map("name_normalized")
  tradeName             String?   @map("trade_name")
  phonePrimary          String?   @map("phone_primary")
  phoneSecondary        String?   @map("phone_secondary")
  whatsapp              String?
  region                String?
  address               String?
  geoLat                Decimal?  @map("geo_lat") @db.Decimal(9, 6)
  geoLng                Decimal?  @map("geo_lng") @db.Decimal(9, 6)
  customerType          String?   @map("customer_type")
  status                String    @default("active")
  relationshipStartDate DateTime? @map("relationship_start_date") @db.Date
  notes                 String?
  createdByImportJob    String?   @map("created_by_import_job") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz()
  mergedIntoId          String?   @map("merged_into_id") @db.Uuid
  mergedAt              DateTime? @map("merged_at") @db.Timestamptz()

  organization  Organization @relation(fields: [organizationId], references: [id])
  branch        Branch?      @relation(fields: [branchId], references: [id])
  mergedInto    Customer?    @relation("CustomerMergeTarget", fields: [mergedIntoId], references: [id])
  mergedSources Customer[]   @relation("CustomerMergeTarget")

  balances                CustomerBalance[]
  creditPolicy            CustomerCreditPolicy?
  creditLimits            CustomerCreditLimit[]
  assignments             CustomerAssignment[]
  importedTxns            ImportedTransaction[]
  balanceSnapshots        BalanceSnapshot[]
  ledgerEntries           OperationalLedger[]
  reconciliations         BalanceReconciliation[]
  followups               Followup[]
  promises                PaymentPromise[]
  collections             Collection[]
  reservations            Reservation[]
  tasks                   Task[]
  scores                  CustomerScore[]
  duplicatesAsA           PotentialDuplicateCustomer[] @relation("DupCustomerA")
  duplicatesAsB           PotentialDuplicateCustomer[] @relation("DupCustomerB")
  agingRows               DebtAgingSummary[]
  agingDocuments          DebtAgingDetail[]
  aliases                 CustomerAlias[]              @relation("CustomerAliasTarget")
  aliasesFromMerge        CustomerAlias[]              @relation("CustomerAliasSource")
  mergeOperationsAsMaster CustomerMerge[]              @relation("CustomerMergeMaster")
  mergeOperationsAsSource CustomerMerge[]              @relation("CustomerMergeSource")
  primaryAccountLinks     CustomerAccountLink[]        @relation("PrimaryCustomerAccount")
  childAccountLink        CustomerAccountLink?         @relation("ChildCustomerAccount")
  agingSnapshots          AgingSnapshot[]

  @@unique([organizationId, externalCustomerCode], map: "uq_customers_org_code")
  @@index([organizationId, nameNormalized], map: "idx_customers_name_norm")
  @@index([phonePrimary], map: "idx_customers_phone")
  @@index([mergedIntoId], map: "idx_customers_merged_into")
  @@map("customers")
}

model CustomerAlias {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  customerId       String   @map("customer_id") @db.Uuid
  sourceCustomerId String?  @map("source_customer_id") @db.Uuid
  mergeId          String?  @map("merge_id") @db.Uuid
  aliasType        String   @map("alias_type")
  aliasValue       String   @map("alias_value")
  aliasNormalized  String   @map("alias_normalized")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()

  organization   Organization   @relation(fields: [organizationId], references: [id])
  customer       Customer       @relation("CustomerAliasTarget", fields: [customerId], references: [id])
  sourceCustomer Customer?      @relation("CustomerAliasSource", fields: [sourceCustomerId], references: [id])
  merge          CustomerMerge? @relation(fields: [mergeId], references: [id])

  @@unique([organizationId, customerId, aliasType, aliasNormalized], map: "uq_customer_alias_org_customer_type_value")
  @@index([customerId], map: "idx_customer_alias_customer")
  @@index([sourceCustomerId], map: "idx_customer_alias_source")
  @@map("customer_aliases")
}

model CustomerMerge {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  masterCustomerId String    @map("master_customer_id") @db.Uuid
  sourceCustomerId String    @map("source_customer_id") @db.Uuid
  pairId           String?   @map("pair_id") @db.Uuid
  status           String    @default("active")
  restorePayload   Json      @map("restore_payload") @db.JsonB
  mergedBy         String    @map("merged_by") @db.Uuid
  mergedAt         DateTime  @default(now()) @map("merged_at") @db.Timestamptz()
  reversibleUntil  DateTime  @map("reversible_until") @db.Timestamptz()
  reversedBy       String?   @map("reversed_by") @db.Uuid
  reversedAt       DateTime? @map("reversed_at") @db.Timestamptz()

  organization Organization    @relation(fields: [organizationId], references: [id])
  master       Customer        @relation("CustomerMergeMaster", fields: [masterCustomerId], references: [id])
  source       Customer        @relation("CustomerMergeSource", fields: [sourceCustomerId], references: [id])
  creator      User            @relation("CustomerMergeCreator", fields: [mergedBy], references: [id])
  reverser     User?           @relation("CustomerMergeReverser", fields: [reversedBy], references: [id])
  aliases      CustomerAlias[]

  @@index([organizationId, mergedAt], map: "idx_customer_merges_org_date")
  @@index([sourceCustomerId, status], map: "idx_customer_merges_source_status")
  @@map("customer_merges")
}

/// Non-destructive relationship between separate customer accounts.
/// The child keeps its own ledger and identity; the primary account only
/// receives a read-only consolidated view of all linked balances.
model CustomerAccountLink {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  primaryCustomerId String   @map("primary_customer_id") @db.Uuid
  childCustomerId   String   @unique(map: "uq_customer_account_link_child") @map("child_customer_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization @relation(fields: [organizationId], references: [id])
  primary      Customer     @relation("PrimaryCustomerAccount", fields: [primaryCustomerId], references: [id], onDelete: Cascade)
  child        Customer     @relation("ChildCustomerAccount", fields: [childCustomerId], references: [id], onDelete: Cascade)

  @@unique([primaryCustomerId, childCustomerId], map: "uq_customer_account_link_pair")
  @@index([organizationId, primaryCustomerId], map: "idx_customer_account_link_primary")
  @@map("customer_account_links")
}

model CustomerAssignment {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId    String    @map("customer_id") @db.Uuid
  collectorId   String    @map("collector_id") @db.Uuid
  effectiveFrom DateTime  @default(dbgenerated("CURRENT_DATE")) @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  reason        String?
  assignedBy    String?   @map("assigned_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  customer  Customer  @relation(fields: [customerId], references: [id])
  collector Collector @relation(fields: [collectorId], references: [id])
  assigner  User?     @relation("AssignmentMaker", fields: [assignedBy], references: [id])

  // ملاحظة: الفهرس الفريد الجزئي uq_current_assignment (WHERE effective_to IS NULL)
  // معرّف في migration SQL — يضمن إسنادًا حاليًا واحدًا فقط لكل عميل.
  @@index([collectorId, effectiveFrom], map: "idx_assignments_collector")
  @@map("customer_assignments")
}

model CustomerCreditPolicy {
  customerId            String    @id @map("customer_id") @db.Uuid
  allowCreditSale       Boolean   @default(false) @map("allow_credit_sale")
  allowPurchaseWithDebt Boolean   @default(false) @map("allow_purchase_with_debt")
  defaultPaymentDays    Int?      @map("default_payment_days")
  creditLimitAmount     Decimal?  @map("credit_limit_amount") @db.Decimal(18, 4)
  creditLimitCurrency   String?   @map("credit_limit_currency")
  creditStatus          String    @default("open") @map("credit_status")
  restrictionReason     String?   @map("restriction_reason")
  decidedBy             String?   @map("decided_by") @db.Uuid
  decidedAt             DateTime? @map("decided_at") @db.Timestamptz()

  customer Customer  @relation(fields: [customerId], references: [id])
  currency Currency? @relation(fields: [creditLimitCurrency], references: [code])
  decider  User?     @relation("CreditDecider", fields: [decidedBy], references: [id])

  @@map("customer_credit_policies")
}

model CustomerCreditLimit {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId    String   @map("customer_id") @db.Uuid
  currencyCode  String   @map("currency_code")
  amount        Decimal  @db.Decimal(18, 4)
  effectiveFrom DateTime @default(dbgenerated("CURRENT_DATE")) @map("effective_from") @db.Date
  approvedBy    String   @map("approved_by") @db.Uuid
  approvedAt    DateTime @default(now()) @map("approved_at") @db.Timestamptz()
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  customer Customer @relation(fields: [customerId], references: [id])
  currency Currency @relation(fields: [currencyCode], references: [code])
  approver User     @relation("CreditLimitApprover", fields: [approvedBy], references: [id])

  @@unique([customerId, currencyCode], map: "uq_customer_credit_limit_currency")
  @@index([currencyCode, amount], map: "idx_credit_limits_currency_amount")
  @@map("customer_credit_limits")
}

model PotentialDuplicateCustomer {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerAId  String    @map("customer_a_id") @db.Uuid
  customerBId  String    @map("customer_b_id") @db.Uuid
  matchReason  String    @map("match_reason")
  reviewStatus String    @default("pending") @map("review_status")
  reviewedBy   String?   @map("reviewed_by") @db.Uuid
  reviewedAt   DateTime? @map("reviewed_at") @db.Timestamptz()

  customerA Customer @relation("DupCustomerA", fields: [customerAId], references: [id])
  customerB Customer @relation("DupCustomerB", fields: [customerBId], references: [id])
  reviewer  User?    @relation("DuplicateReviewer", fields: [reviewedBy], references: [id])

  @@unique([customerAId, customerBId], map: "uq_dup_pair")
  @@map("potential_duplicate_customers")
}

// ---------------------------------------------------------------------------
// 5) الاستيراد والأرصدة المحاسبية
// ---------------------------------------------------------------------------
model ImportTemplate {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  columnMapping  Json     @map("column_mapping") @db.JsonB
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization @relation(fields: [organizationId], references: [id])
  creator      User?        @relation(fields: [createdBy], references: [id])
  importJobs   ImportJob[]

  @@map("import_templates")
}

model ImportJob {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String    @map("organization_id") @db.Uuid
  templateId            String?   @map("template_id") @db.Uuid
  fileName              String    @map("file_name")
  fileHash              String    @map("file_hash")
  uploadedBy            String    @map("uploaded_by") @db.Uuid
  importedAt            DateTime  @default(now()) @map("imported_at") @db.Timestamptz()
  status                String    @default("completed")
  rowsTotal             Int?      @map("rows_total")
  txnsInFile            Int?      @map("txns_in_file")
  customersNew          Int?      @map("customers_new")
  customersUpdated      Int?      @map("customers_updated")
  txnsInserted          Int?      @map("txns_inserted")
  txnsSkippedDuplicate  Int?      @map("txns_skipped_duplicate")
  errorsCount           Int?      @map("errors_count")
  totalBalanceBefore    Json?     @map("total_balance_before") @db.JsonB
  totalBalanceAfter     Json?     @map("total_balance_after") @db.JsonB
  errorReport           Json?     @map("error_report") @db.JsonB
  agingRowsWritten      Int?      @map("aging_rows_written")
  agingDocumentsWritten Int?      @map("aging_documents_written")
  agingSkippedDuplicate Int?      @map("aging_skipped_duplicate")
  rollbackState         Json?     @map("rollback_state") @db.JsonB
  reversedBy            String?   @map("reversed_by") @db.Uuid
  reversedAt            DateTime? @map("reversed_at") @db.Timestamptz()
  reversalReason        String?   @map("reversal_reason")

  organization Organization    @relation(fields: [organizationId], references: [id])
  template     ImportTemplate? @relation(fields: [templateId], references: [id])
  uploader     User            @relation(fields: [uploadedBy], references: [id])
  reverser     User?           @relation("ImportJobReverser", fields: [reversedBy], references: [id])

  transactions        ImportedTransaction[]
  balancesUpdated     CustomerBalance[]
  snapshots           BalanceSnapshot[]
  reconciliations     BalanceReconciliation[]
  agingRows           DebtAgingSummary[]
  agingDocuments      DebtAgingDetail[]
  analyticalMovements AnalyticalMovement[]

  @@index([organizationId, fileHash], map: "idx_import_jobs_hash")
  @@map("import_jobs")
}

model ImportedTransaction {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId      String    @map("customer_id") @db.Uuid
  currencyCode    String    @map("currency_code")
  documentTypeId  String    @map("document_type_id") @db.Uuid
  txDate          DateTime  @map("tx_date") @db.Date
  documentNumber  String?   @map("document_number")
  description     String?
  referenceNumber String?   @map("reference_number")
  debit           Decimal   @default(0) @db.Decimal(18, 4)
  credit          Decimal   @default(0) @db.Decimal(18, 4)
  lineHash        String    @map("line_hash")
  sourceRowNumber Int?      @map("source_row_number")
  importJobId     String    @map("import_job_id") @db.Uuid
  reversedAt      DateTime? @map("reversed_at") @db.Timestamptz()

  customer     Customer     @relation(fields: [customerId], references: [id])
  currency     Currency     @relation(fields: [currencyCode], references: [code])
  documentType DocumentType @relation(fields: [documentTypeId], references: [id])
  importJob    ImportJob    @relation(fields: [importJobId], references: [id])

  @@index([customerId, currencyCode, txDate], map: "idx_itxn_customer")
  @@index([importJobId], map: "idx_itxn_job")
