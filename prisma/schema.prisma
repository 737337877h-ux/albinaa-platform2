// ---------------------------------------------------------------------------
// Oracle inventory mirror — additive, versioned, and read-only to consumers.
// Each extraction is isolated by sync_run_id and becomes visible only when the
// active snapshot pointer is switched after validation.
// ---------------------------------------------------------------------------
model OracleInventorySyncRun {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  sourceSchema      String    @map("source_schema") @db.VarChar(30)
  mode              String    @default("full_snapshot") @db.VarChar(30)
  status            String    @default("extracting") @db.VarChar(20)
  previousRunId     String?   @map("previous_run_id") @db.Uuid
  triggeredBy       String?   @map("triggered_by") @db.Uuid
  startedAt         DateTime  @default(now()) @map("started_at") @db.Timestamptz()
  extractedAt       DateTime? @map("extracted_at") @db.Timestamptz()
  validatedAt       DateTime? @map("validated_at") @db.Timestamptz()
  publishedAt       DateTime? @map("published_at") @db.Timestamptz()
  sourceCounts      Json?     @map("source_counts") @db.JsonB
  loadedCounts      Json?     @map("loaded_counts") @db.JsonB
  validationSummary Json?     @map("validation_summary") @db.JsonB
  manifestHash      String?   @map("manifest_hash") @db.VarChar(64)
  errorSummary      Json?     @map("error_summary") @db.JsonB

  organization      Organization                    @relation(fields: [organizationId], references: [id])
  previousRun       OracleInventorySyncRun?         @relation("OracleSyncPrevious", fields: [previousRunId], references: [id])
  nextRuns          OracleInventorySyncRun[]        @relation("OracleSyncPrevious")
  triggeredByUser   User?                           @relation("OracleSyncTriggeredBy", fields: [triggeredBy], references: [id])
  activeSnapshots   OracleInventoryActiveSnapshot[] @relation("OracleActiveRun")
  previousSnapshots OracleInventoryActiveSnapshot[] @relation("OraclePreviousRun")
  itemGroups        OracleItemGroupMirror[]
  items             OracleItemMirror[]
  itemUnits         OracleItemUnitMirror[]
  warehouseGroups   OracleWarehouseGroupMirror[]
  warehouses        OracleWarehouseMirror[]
  stockBalances     OracleStockBalanceMirror[]
  issues            OracleSyncIssue[]

  @@index([organizationId, startedAt], map: "idx_oracle_sync_runs_org_started")
  @@index([organizationId, status], map: "idx_oracle_sync_runs_org_status")
  @@map("oracle_inventory_sync_runs")
}

