model ReservationItem {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reservationId String  @map("reservation_id") @db.Uuid
  itemName      String  @map("item_name")
  quantity      Decimal @db.Decimal(18, 4)
  unit          String
  receivedQty   Decimal @default(0) @map("received_qty") @db.Decimal(18, 4)

  reservation Reservation @relation(fields: [reservationId], references: [id])

  @@map("reservation_items")
}

// ---------------------------------------------------------------------------
// 10) التقييم، المرفقات، الإشعارات، التدقيق، الإعدادات
// ---------------------------------------------------------------------------
model CustomerScore {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  score      Decimal  @db.Decimal(6, 2)
  riskLevel  String   @map("risk_level")
  reasons    Json     @db.JsonB
  computedAt DateTime @default(now()) @map("computed_at") @db.Timestamptz()

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, computedAt], map: "idx_scores_customer")
  @@map("customer_scores")
}

model Attachment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityTable String   @map("entity_table")
  entityId    String   @map("entity_id") @db.Uuid
  fileName    String   @map("file_name")
  storageKey  String   @map("storage_key")
  uploadedBy  String?  @map("uploaded_by") @db.Uuid
  uploadedAt  DateTime @default(now()) @map("uploaded_at") @db.Timestamptz()

  uploader User? @relation(fields: [uploadedBy], references: [id])

  @@index([entityTable, entityId], map: "idx_attachments_entity")
  @@map("attachments")
}

model GpsLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  entityTable String?  @map("entity_table")
  entityId    String?  @map("entity_id") @db.Uuid
  latitude    Float
  longitude   Float
  accuracy    Float?
  timestamp   DateTime @default(now()) @map("timestamp") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id])

  @@index([entityTable, entityId])
  @@index([userId, timestamp])
  @@map("gps_logs")
}

model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  kind      String
  payload   Json      @db.JsonB
  readAt    DateTime? @map("read_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id])

  @@index([userId, readAt], map: "idx_notifications_user")
  @@map("notifications")
}

model AccountingPeriod {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  year           Int
  month          Int
  status         String    @default("locked")
  reason         String
  lockedBy       String    @map("locked_by") @db.Uuid
  lockedAt       DateTime  @default(now()) @map("locked_at") @db.Timestamptz()
  unlockedBy     String?   @map("unlocked_by") @db.Uuid
  unlockedAt     DateTime? @map("unlocked_at") @db.Timestamptz()
  unlockReason   String?   @map("unlock_reason")

  @@unique([organizationId, year, month], map: "uq_accounting_period_org_month")
  @@index([organizationId, status, year, month], map: "idx_accounting_period_status")
  @@map("accounting_periods")
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  action      String
  entityTable String   @map("entity_table")
  entityId    String?  @map("entity_id")
  oldValue    Json?    @map("old_value") @db.JsonB
  newValue    Json?    @map("new_value") @db.JsonB
  reason      String?
  ipAddress   String?  @map("ip_address") @db.Inet
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user User? @relation(fields: [userId], references: [id])

  @@index([entityTable, entityId, createdAt], map: "idx_audit_entity")
  @@index([userId, createdAt], map: "idx_audit_user")
  @@map("audit_logs")
}

model SystemSetting {
  organizationId String @map("organization_id") @db.Uuid
  key            String
  value          Json   @db.JsonB

  organization Organization @relation(fields: [organizationId], references: [id])

  @@id([organizationId, key])
  @@map("system_settings")
}

// ---------------------------------------------------------------------------
// Milestone 8: Idempotency keys (منع تكرار العمليات من تطبيق المحصل)
// ---------------------------------------------------------------------------
model IdempotencyKey {
  key       String   @id
  response  Json     @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([createdAt], map: "idx_idempotency_created")
  @@map("idempotency_keys")
}

// ---------------------------------------------------------------------------
// Milestone 2: جلسات المصادقة (Refresh Tokens مجزأة وقابلة للإبطال)
// سبب الإضافة موثق في migration 20260718000000_auth_sessions
// ---------------------------------------------------------------------------
model AuthSession {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz()
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz()
  replacedById String?   @map("replaced_by_id") @db.Uuid
  ipAddress    String?   @map("ip_address") @db.Inet
  userAgent    String?   @map("user_agent")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user       User          @relation(fields: [userId], references: [id])
  replacedBy AuthSession?  @relation("SessionRotation", fields: [replacedById], references: [id])
  replaces   AuthSession[] @relation("SessionRotation")

  @@index([userId, revokedAt], map: "idx_auth_sessions_user")
  @@map("auth_sessions")
}

// ---------------------------------------------------------------------------
// PR-7: Analytical Accounts — extensible non-customer accounting accounts
// (debtors, employee advances, employee custodies, and future types).
// Fully separate from Customer/CustomerBalance — never touches
// accountingBalance/operationalBalance, never affects collections.
// ---------------------------------------------------------------------------
model AnalyticalAccount {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  accountNumber  String   @map("account_number")
  accountName    String   @map("account_name")
  category       String // debtor | employee_advance | employee_custody | other
  personName     String?  @map("person_name")
  employeeNumber String?  @map("employee_number")
  currencyCode   String   @map("currency_code")
  status         String   @default("active")
  metadata       Json?    @db.JsonB
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  organization Organization         @relation(fields: [organizationId], references: [id])
  currency     Currency             @relation(fields: [currencyCode], references: [code])
  creator      User?                @relation("AnalyticalAccountCreator", fields: [createdBy], references: [id])
  movements    AnalyticalMovement[]

  @@unique([organizationId, accountNumber, currencyCode], map: "uq_analytical_account_org_number_ccy")
  @@index([organizationId, category], map: "idx_analytical_accounts_category")
  @@map("analytical_accounts")
}

model AnalyticalMovement {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId         String    @map("account_id") @db.Uuid
  currencyCode      String    @map("currency_code")
  txDate            DateTime  @map("tx_date") @db.Date
  documentType      String?   @map("document_type")
  documentNumber    String?   @map("document_number")
  description       String?
  debit             Decimal   @default(0) @db.Decimal(18, 4)
  credit            Decimal   @default(0) @db.Decimal(18, 4)
  sourceImportJobId String?   @map("source_import_job_id") @db.Uuid
  sourceRowNumber   Int?      @map("source_row_number")
  lineHash          String    @map("line_hash")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  reversedAt        DateTime? @map("reversed_at") @db.Timestamptz()

  account         AnalyticalAccount @relation(fields: [accountId], references: [id])
  currency        Currency          @relation(fields: [currencyCode], references: [code])
  sourceImportJob ImportJob?        @relation(fields: [sourceImportJobId], references: [id])

  @@index([accountId, currencyCode, txDate], map: "idx_analytical_movements_account")
  @@map("analytical_movements")
}
