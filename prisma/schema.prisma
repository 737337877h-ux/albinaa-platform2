  // --- Legacy fields (pre-PR-F credit-reservation shape) — kept as-is, not dropped, not used by app code ---
  creditAmount Decimal   @map("credit_amount") @db.Decimal(18, 4)
  usedAmount   Decimal   @default(0) @map("used_amount") @db.Decimal(18, 4)
  paymentDate  DateTime? @map("payment_date") @db.Date

  // --- Goods reservation fields (PR-F) — nullable so this ADD COLUMN stays non-destructive ---
  itemName     String?  @map("item_name")
  itemType     String?  @map("item_type")
  quantity     Decimal? @db.Decimal(18, 4)
  unit         String?
  unitId       String?  @map("unit_id") @db.Uuid
  unitPrice    Decimal? @map("unit_price") @db.Decimal(18, 4)
  totalAmount  Decimal? @map("total_amount") @db.Decimal(18, 4)
