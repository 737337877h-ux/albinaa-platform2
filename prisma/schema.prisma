model CollectionMethod {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  name           String
  active         Boolean @default(true)

  organization Organization     @relation(fields: [organizationId], references: [id])
  collections  Collection[]
  promises     PaymentPromise[]

  @@unique([organizationId, name], map: "uq_methods_org_name")
  @@map("collection_methods")
}

model Collection {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId      String    @map("customer_id") @db.Uuid
  collectorId     String    @map("collector_id") @db.Uuid
  branchId        String?   @map("branch_id") @db.Uuid
  currencyCode    String    @map("currency_code")
  amount          Decimal   @db.Decimal(18, 4)
  collectedAt     DateTime  @default(now()) @map("collected_at") @db.Timestamptz()
  methodId        String    @map("method_id") @db.Uuid
  referenceNumber String?   @map("reference_number")
  bankName        String?   @map("bank_name")
  chequeNumber    String?   @map("cheque_number")
  chequeDate      DateTime? @map("cheque_date") @db.Date
  receiptNumber   String?   @map("receipt_number")
  notes           String?
  status          String    @default("recorded")
  reversedById    String?   @map("reversed_by_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  customer            Customer                    @relation(fields: [customerId], references: [id])
  collector           Collector                   @relation(fields: [collectorId], references: [id])
  currency            Currency                    @relation(fields: [currencyCode], references: [code])
  method              CollectionMethod            @relation(fields: [methodId], references: [id])
  reversedBy          Collection?                 @relation("CollectionReversal", fields: [reversedById], references: [id])
  reversals           Collection[]                @relation("CollectionReversal")
  handover            CashHandover?
  branch              Branch?                     @relation(fields: [branchId], references: [id])
  handoverVoucherItem CollectionHandoverItem?
  reversalRequests    CollectionReversalRequest[]

  @@index([customerId, currencyCode, collectedAt], map: "idx_collections_customer")
  @@index([collectorId, collectedAt], map: "idx_collections_collector")
  @@index([status, collectedAt], map: "idx_collections_status")
  @@map("collections")
}

model CashHandover {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collectionId  String   @unique @map("collection_id") @db.Uuid
  currencyCode  String   @map("currency_code")
  amount        Decimal  @db.Decimal(18, 4)
  cashierId     String   @map("cashier_id") @db.Uuid
  receiptNumber String?  @map("receipt_number")
  receivedAt    DateTime @default(now()) @map("received_at") @db.Timestamptz()

  collection Collection @relation(fields: [collectionId], references: [id])
  currency   Currency   @relation(fields: [currencyCode], references: [code])
  cashier    User       @relation(fields: [cashierId], references: [id])

  @@map("cash_handover")
}

model BranchReceiptSequence {
  branchId   String @map("branch_id") @db.Uuid
  year       Int
  nextNumber Int    @default(1) @map("next_number")

  branch Branch @relation(fields: [branchId], references: [id])

  @@id([branchId, year])
  @@map("branch_receipt_sequences")
}

model BranchVoucherSequence {
  branchId   String @map("branch_id") @db.Uuid
  year       Int
  nextNumber Int    @default(1) @map("next_number")

  branch Branch @relation(fields: [branchId], references: [id])

  @@id([branchId, year])
  @@map("branch_voucher_sequences")
}

model CollectionHandoverVoucher {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  branchId       String    @map("branch_id") @db.Uuid
  collectorId    String    @map("collector_id") @db.Uuid
  currencyCode   String    @map("currency_code")
  serialNumber   String    @map("serial_number")
  sequenceYear   Int       @map("sequence_year")
  sequenceNumber Int       @map("sequence_number")
  totalAmount    Decimal   @map("total_amount") @db.Decimal(18, 4)
  status         String    @default("submitted")
  createdBy      String    @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  matchedBy      String?   @map("matched_by") @db.Uuid
  matchedAt      DateTime? @map("matched_at") @db.Timestamptz()
  approvedBy     String?   @map("approved_by") @db.Uuid
  approvedAt     DateTime? @map("approved_at") @db.Timestamptz()

  organization Organization             @relation(fields: [organizationId], references: [id])
  branch       Branch                   @relation(fields: [branchId], references: [id])
  collector    Collector                @relation(fields: [collectorId], references: [id])
  currency     Currency                 @relation(fields: [currencyCode], references: [code])
  creator      User                     @relation("HandoverVoucherCreator", fields: [createdBy], references: [id])
  matcher      User?                    @relation("HandoverVoucherMatcher", fields: [matchedBy], references: [id])
  approver     User?                    @relation("HandoverVoucherApprover", fields: [approvedBy], references: [id])
  items        CollectionHandoverItem[]

  @@unique([organizationId, serialNumber], map: "uq_handover_voucher_org_serial")
  @@unique([branchId, sequenceYear, sequenceNumber], map: "uq_handover_voucher_branch_sequence")
  @@index([organizationId, status, createdAt], map: "idx_handover_voucher_status")
  @@map("collection_handover_vouchers")
}

model CollectionHandoverItem {
  voucherId    String  @map("voucher_id") @db.Uuid
  collectionId String  @unique @map("collection_id") @db.Uuid
  amount       Decimal @db.Decimal(18, 4)

  voucher    CollectionHandoverVoucher @relation(fields: [voucherId], references: [id])
  collection Collection                @relation(fields: [collectionId], references: [id])

  @@id([voucherId, collectionId])
  @@map("collection_handover_items")
}

model CollectionReversalRequest {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collectionId String    @map("collection_id") @db.Uuid
  reason       String
  status       String    @default("pending")
  requestedBy  String    @map("requested_by") @db.Uuid
  requestedAt  DateTime  @default(now()) @map("requested_at") @db.Timestamptz()
  reviewedBy   String?   @map("reviewed_by") @db.Uuid
  reviewedAt   DateTime? @map("reviewed_at") @db.Timestamptz()
  reviewNote   String?   @map("review_note")
  reversalId   String?   @map("reversal_id") @db.Uuid

  collection Collection @relation(fields: [collectionId], references: [id])
  requester  User       @relation("CollectionReversalRequester", fields: [requestedBy], references: [id])
  reviewer   User?      @relation("CollectionReversalReviewer", fields: [reviewedBy], references: [id])

  @@index([collectionId, status], map: "idx_collection_reversal_request")
  @@index([status, requestedAt], map: "idx_collection_reversal_pending")
  @@map("collection_reversal_requests")
}

model FollowupType {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  name           String
  active         Boolean @default(true)

  organization Organization @relation(fields: [organizationId], references: [id])
  followups    Followup[]

  @@unique([organizationId, name], map: "uq_ftypes_org_name")
  @@map("followup_types")
}

model FollowupResult {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  name           String
  active         Boolean @default(true)

  organization Organization @relation(fields: [organizationId], references: [id])
  followups    Followup[]

  @@unique([organizationId, name], map: "uq_fresults_org_name")
  @@map("followup_results")
}

model Followup {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId       String    @map("customer_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  typeId           String    @map("type_id") @db.Uuid
  resultId         String    @map("result_id") @db.Uuid
  followupAt       DateTime  @default(now()) @map("followup_at") @db.Timestamptz()
  notes            String?
  nextFollowupDate DateTime? @map("next_followup_date") @db.Date
  expectedAmount   Decimal?  @map("expected_amount") @db.Decimal(18, 4)
  expectedCurrency String?   @map("expected_currency")
  visitLat         Decimal?  @map("visit_lat") @db.Decimal(9, 6)
  visitLng         Decimal?  @map("visit_lng") @db.Decimal(9, 6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz()
  deletedBy        String?   @map("deleted_by") @db.Uuid

  customer Customer       @relation(fields: [customerId], references: [id])
  user     User           @relation(fields: [userId], references: [id])
  type     FollowupType   @relation(fields: [typeId], references: [id])
  result   FollowupResult @relation(fields: [resultId], references: [id])
  currency Currency?      @relation(fields: [expectedCurrency], references: [code])

  @@index([customerId, followupAt], map: "idx_followups_customer")
  @@index([nextFollowupDate], map: "idx_followups_next")
  @@index([userId, followupAt], map: "idx_followups_user")
  @@map("followups")
}

model PaymentPromise {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId       String   @map("customer_id") @db.Uuid
  collectorId      String   @map("collector_id") @db.Uuid
  promiseDate      DateTime @map("promise_date") @db.Date
  dueDate          DateTime @map("due_date") @db.Date
  statusReason     String?  @map("status_reason")
  fulfilledAmount  Decimal? @map("fulfilled_amount") @db.Decimal(18, 4)
  settlementDate   DateTime? @map("settlement_date") @db.Date
  settledLate      Boolean  @default(false) @map("settled_late")
  missedDueDate    DateTime? @map("missed_due_date") @db.Date
  expectedAmount   Decimal  @map("expected_amount") @db.Decimal(18, 4)
  currencyCode     String   @map("currency_code")
  expectedMethodId String?  @map("expected_method_id") @db.Uuid
  notes            String?
  status           String   @default("upcoming")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()

  customer       Customer          @relation(fields: [customerId], references: [id])
  collector      Collector         @relation(fields: [collectorId], references: [id])
  currency       Currency          @relation(fields: [currencyCode], references: [code])
  expectedMethod CollectionMethod? @relation(fields: [expectedMethodId], references: [id])
  tasks          Task[]
  receiptAllocations PaymentPromiseReceiptAllocation[]

  @@index([promiseDate, status], map: "idx_promises_date")
  @@index([customerId, status], map: "idx_promises_customer")
  @@index([dueDate, status], map: "idx_promises_due")
  @@map("payment_promises")
}

model PaymentPromiseReceiptAllocation {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  promiseId      String @map("promise_id") @db.Uuid
  customerId     String @map("customer_id") @db.Uuid
  currencyCode   String @map("currency_code")
  receiptKey     String @map("receipt_key") @db.VarChar(500)
  receiptAmount  Decimal @map("receipt_amount") @db.Decimal(18, 4)
  amount         Decimal @db.Decimal(18, 4)
  receiptDate    DateTime @map("receipt_date") @db.Date
  source         String @db.VarChar(30)
  sourceId       String @map("source_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  promise PaymentPromise @relation(fields: [promiseId], references: [id], onDelete: Restrict)

  @@unique([organizationId, receiptKey, promiseId], map: "uq_promise_receipt_allocation")
  @@index([organizationId, receiptKey], map: "idx_promise_receipt_capacity")
  @@index([promiseId], map: "idx_promise_receipt_promise")
  @@map("payment_promise_receipt_allocations")
}

model Task {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId       String?  @map("customer_id") @db.Uuid
  assignedTo       String?  @map("assigned_to") @db.Uuid
  createdBy        String?  @map("created_by") @db.Uuid
  taskType         String   @map("task_type")
  dueDate          DateTime @map("due_date") @db.Date
  priorityReason   String?  @map("priority_reason")
  expectedAmount   Decimal? @map("expected_amount") @db.Decimal(18, 4)
  expectedCurrency String?  @map("expected_currency")
  status           String   @default("open")
  sourcePromiseId  String?  @map("source_promise_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()

  customer      Customer?       @relation(fields: [customerId], references: [id])
  collector     Collector?      @relation(fields: [assignedTo], references: [id])
  creator       User?           @relation("TaskCreator", fields: [createdBy], references: [id])
  currency      Currency?       @relation(fields: [expectedCurrency], references: [code])
  sourcePromise PaymentPromise? @relation(fields: [sourcePromiseId], references: [id])

  @@index([assignedTo, dueDate, status], map: "idx_tasks_due")
  @@index([customerId], map: "idx_tasks_customer")
  @@map("tasks")
}

// ---------------------------------------------------------------------------
// 9) الحجوزات
// ---------------------------------------------------------------------------
model Reservation {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId   String @map("customer_id") @db.Uuid
  currencyCode String @map("currency_code")

  // --- Legacy fields (pre-PR-F credit-reservation shape) — kept as-is, not dropped, not used by app code ---
  creditAmount Decimal   @map("credit_amount") @db.Decimal(18, 4)
  usedAmount   Decimal   @default(0) @map("used_amount") @db.Decimal(18, 4)
  paymentDate  DateTime? @map("payment_date") @db.Date

  // --- Goods reservation fields (PR-F) — nullable so this ADD COLUMN stays non-destructive ---
  itemName      String?  @map("item_name")
  itemType      String?  @map("item_type")
  quantity      Decimal? @db.Decimal(18, 4)
  unit          String?
  unitId        String?  @map("unit_id") @db.Uuid
  unitPrice     Decimal? @map("unit_price") @db.Decimal(18, 4)
  totalAmount   Decimal? @map("total_amount") @db.Decimal(18, 4)
  totalTons     Decimal? @map("total_tons") @db.Decimal(18, 6)
  remainingTons Decimal? @map("remaining_tons") @db.Decimal(18, 6)
  issuedQty     Decimal  @default(0) @map("issued_qty") @db.Decimal(18, 4)
  remainingQty  Decimal? @map("remaining_qty") @db.Decimal(18, 4)
  createdBy     String?  @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  documentNumber String?   @map("document_number")
  warehouse      String?
  reservedAt     DateTime  @default(dbgenerated("CURRENT_DATE")) @map("reserved_at") @db.Date
  expiresAt      DateTime? @map("expires_at") @db.Date
  status         String    @default("open")
  notes          String?

  customer    Customer                @relation(fields: [customerId], references: [id])
  currency    Currency                @relation(fields: [currencyCode], references: [code])
  creator     User?                   @relation("ReservationCreator", fields: [createdBy], references: [id])
  measureUnit Unit?                   @relation(fields: [unitId], references: [id])
  items       ReservationItem[]
  adjustments ReservationAdjustment[]

  @@index([customerId], map: "idx_reservations_customer")
  @@index([status, expiresAt], map: "idx_reservations_status_expiry")
  @@map("reservations")
}

model ReservationAdjustment {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reservationId     String    @map("reservation_id") @db.Uuid
  sourceMovementId  String?   @map("source_movement_id") @db.Uuid
  sourceFingerprint String    @map("source_fingerprint") @db.VarChar(64)
  adjustmentType    String    @map("adjustment_type") @db.VarChar(20)
  externalItemCode  String    @map("external_item_code") @db.VarChar(30)
  rodsQuantity      Decimal   @map("rods_quantity") @db.Decimal(18, 4)
  rodsPerTon        Int       @map("rods_per_ton")
  tonsDelta         Decimal   @map("tons_delta") @db.Decimal(18, 6)
  documentType      String?   @map("document_type") @db.VarChar(20)
  documentNumber    String?   @map("document_number") @db.VarChar(50)
  movementDate      DateTime  @map("movement_date") @db.Date
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  reversedAt        DateTime? @map("reversed_at") @db.Timestamptz()

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@unique([reservationId, sourceFingerprint], map: "uq_reservation_adjustment_source")
  @@index([reservationId, createdAt], map: "idx_reservation_adjustments_reservation")
  @@map("reservation_adjustments")
}

model Unit {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique
  nameAr    String   @map("name_ar")
  weightKg  Decimal? @map("weight_kg") @db.Decimal(14, 4)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  reservations Reservation[]

  @@map("units")
}

model MessageCampaign {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  createdBy      String   @map("created_by") @db.Uuid
  name           String
  channel        String
  templateId     String   @map("template_id")
  agingBucket    String   @map("aging_bucket")
  currencyCode   String?  @map("currency_code")
  status         String   @default("prepared")
  provider       String   @default("none")
  totalCount     Int      @default(0) @map("total_count")
  readyCount     Int      @default(0) @map("ready_count")
  skippedCount   Int      @default(0) @map("skipped_count")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization      @relation(fields: [organizationId], references: [id])
  creator      User              @relation("MessageCampaignCreator", fields: [createdBy], references: [id])
  dispatches   MessageDispatch[]

  @@index([organizationId, createdAt], map: "idx_message_campaigns_org_created")
  @@map("message_campaigns")
}

model MessageDispatch {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId        String    @map("campaign_id") @db.Uuid
  customerId        String    @map("customer_id") @db.Uuid
  destination       String?
  renderedMessage   String    @map("rendered_message")
  status            String    @default("prepared")
  errorMessage      String?   @map("error_message")
  providerMessageId String?   @map("provider_message_id")
  sentAt            DateTime? @map("sent_at") @db.Timestamptz()
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  campaign MessageCampaign @relation(fields: [campaignId], references: [id])
  customer Customer        @relation(fields: [customerId], references: [id])

  @@unique([campaignId, customerId], map: "uq_message_dispatch_campaign_customer")
  @@index([customerId, createdAt], map: "idx_message_dispatch_customer_created")
  @@map("message_dispatches")
}

model ReservationItem {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reservationId String  @map("reservation_id") @db.Uuid
  itemName      String  @map("item_name")
  quantity      Decimal @db.Decimal(18, 4)
  unit          String
  receivedQty   Decimal @default(0) @map("received_qty") @db.Decimal(18, 4)

  reservation Reservation @relation(fields: [reservationId], references: [id])

  @@map("reservation_items")
}

