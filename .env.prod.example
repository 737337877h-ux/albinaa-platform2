# ============================================================================
# منصة البناء الراقي — Production Environment Variables
# انسخ هذا الملف إلى .env.prod واملأ القيم
# ============================================================================

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=albinaa
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=albinaa

# ── Backend ──────────────────────────────────────────────────
APP_VERSION=1.3.0-rc.1
JWT_ACCESS_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM_HEX_STRING_HERE_GENERATE_WITH_openssl_rand_hex_64
JWT_REFRESH_SECRET=CHANGE_ME_MIN_32_CHARS_DIFFERENT_RANDOM_HEX_STRING_HERE
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
ADMIN_INITIAL_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# ── CORS ─────────────────────────────────────────────────────
# List all allowed origins, comma-separated (no spaces)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://yourdomain.com/api

# ── Nginx ────────────────────────────────────────────────────
HTTPS_PORT=443
HTTP_PORT=80

# ── Backup ────────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=30

# ── Sessions ──────────────────────────────────────────────────
MAX_SESSIONS_PER_USER=5

# Daily risk-score refresh at 02:00 Asia/Aden
RISK_AUTO_RECALCULATE_ENABLED=true
RISK_RECALCULATE_HOUR=2
AGING_MONTHLY_SNAPSHOT_ENABLED=true
